PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3000
SESSION_SECRET=change-this-long-random-string

# PostgreSQL
DATABASE_URL=postgres://aset_tb_user:aset_tb_password@127.0.0.1:5432/aset_tb

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback

# AI chatbot
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_PRIMARY=gemini-2.5-flash-lite
GEMINI_MODEL_FALLBACK=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.9
GEMINI_MAX_OUTPUT_TOKENS=250

# Optional fallback provider
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini

# Email reminders, 5 minutes before medication schedule
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_APP_URL=http://127.0.0.1:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="ASET-TB <your-email@gmail.com>"

# Admin dashboard login
ADMIN_USERNAME=hcahyanto@ikbis.ac.id
ADMIN_PASSWORD=change-this-admin-password
